# =============================================================================
# Smart Hospital Management System - Environment Configuration
# =============================================================================

# Server settings
HOSPITAL_HOST=127.0.0.1
PORT=5000
HOSPITAL_DEBUG=0
HOSPITAL_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# Database configuration
HOSPITAL_DB_PATH=./hospital.db
FLASK_API_MODE=real

# Security and Secret Key (generate a strong random hex string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Administrator Initial Setup Credentials (used by bootstrap_admin.py)
HOSPITAL_ADMIN_USER=admin
HOSPITAL_ADMIN_PASSWORD=change_this_to_a_strong_password_123

# Session and Cookie Configuration
HOSPITAL_SESSION_COOKIE=hospital_session
HOSPITAL_COOKIE_SAMESITE=Lax
HOSPITAL_COOKIE_SECURE=0
HOSPITAL_SESSION_HOURS=12

# Rate Limiting / Brute-force Throttling
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# CORS Allowed Origins (comma-separated origins allowed to access the backend API)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Standalone Frontend URLs
SCHEMA_DEMO_URL=http://127.0.0.1:5174
MAIN_APP_URL=http://127.0.0.1:5000
